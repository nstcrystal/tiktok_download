    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "esbuild": "^0.28.1",
    "npm-run-all2": "^9.0.2",
    "prettier": "3.8.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.0",
